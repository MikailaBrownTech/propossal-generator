# This app's own deployed URL, no trailing slash (http://localhost:3000 in
# dev). Used to build the password-reset email's callback link -- it must
# also be added to this Supabase project's Auth -> URL Configuration ->
# Redirect URLs allowlist (as `<value>/auth/confirm`), or Supabase will
# reject the redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key -- server-only, bypasses RLS. Used exclusively by the
# Vercel Cron route that dispatches scheduled sends (no user session
# exists in that context). Never expose to the browser, never use it from
# a Server Component/Action that runs on behalf of a signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API -- server-side only, never read from the browser.
ANTHROPIC_API_KEY=
# Model used for structured extraction (meeting notes / vuln report / risk
# assessment -> client profile fields + findings). Mechanical, structured
# task -- a fast/cheap model is fine here.
ANTHROPIC_MODEL_EXTRACTION=claude-haiku-4-5-20251001
# Model used for Findings Report and Proposal narrative generation, where
# writing quality matters.
ANTHROPIC_MODEL_NARRATIVE=claude-sonnet-5

# Resend (outbound email for approved report/proposal delivery)
RESEND_API_KEY=
# Must be a verified sender address on a domain verified in Resend, e.g.
# "ClearPath IT <reports@clearpathsecure.com>" -- not a bare domain.
RESEND_FROM_EMAIL=

# Shared secret the Vercel Cron job sends as a header when it hits the
# scheduled-send dispatch route, so that route can reject any other caller.
CRON_SECRET=
